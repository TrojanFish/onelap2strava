# Onelap2Strava Environment Variables Example

# Application Port (Default: 8766)
# PORT=8766

# JWT Secret Key (MUST CHANGE IN PRODUCTION!)
# Used for encrypting session cookies and auth tokens
SECRET_KEY=your_super_secret_jwt_key_here

# AES-256 Encryption Key (MUST CHANGE IN PRODUCTION!)
# Must be exactly 32 hex characters! (e.g., a 16-byte random string in hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ====================================================
# [OPTIONAL] Platform-level Strava OAuth Integration
# ====================================================
# If you want to enable the "One-Click Strava Authorization" feature for all users
# on your platform, fill in your Strava Developer Application details below.
# Users will then be able to authorize Strava without supplying their own API keys.
PLATFORM_STRAVA_CLIENT_ID=
PLATFORM_STRAVA_CLIENT_SECRET=
